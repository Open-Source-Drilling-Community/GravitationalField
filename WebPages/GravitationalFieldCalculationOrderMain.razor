@page "/GravitationalField"
@page "/GravitationalFieldCalculation"
@inject ILogger<GravitationalFieldCalculationOrderMain> logger
@inject IGravitationalFieldAPIUtils Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudUnitAndReferenceChoiceTag HttpHost=@Api.HostNameUnitConversion
                              HttpBasePath=@Api.HostBasePathUnitConversion
                              HttpController="UnitSystem/"
                              UnitSystemName="@DataUtils.UnitAndReferenceParameters.UnitSystemName"
                              UnitSystemNameChanged="@DataUtils.UpdateUnitSystemName">
    @if (gravitationalFieldCalculationOrderList == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div hidden="@isHiddenMainPanel">
            <MudDataGrid T="GravitationalFieldCalculationOrder" MultiSelection="true" Items="@gravitationalFieldCalculationOrderList"
                         SelectedItemsChanged="@SelectedItemsChanged" EditMode="DataGridEditMode.Cell"
                         Hover="true" RowClick="@RowClicked"
                         SortMode="SortMode.Multiple" QuickFilter="@_gravitationalFieldCalculationOrderFilter" Filterable="false"
                         ReadOnly="false" ColumnResizeMode="ResizeMode.Column" Elevation="0">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Earth Gravitational Field Batch Calculation</MudText>
                    <MudButton OnClick="@AddGravitationalFieldCalculationOrder" Color="@Color.Success" Class="add-item-btn">Add</MudButton>
                    <MudButton OnClick="@DeleteSelectedGravitationalFieldCalculationOrder" Color="@Color.Error" Class="add-item-btn">Delete</MudButton>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <Columns>
                    <SelectColumn T="GravitationalFieldCalculationOrder" />
                    <PropertyColumn Property="x => x.Name" Title="Name" CellStyle="width: 30%;" Sortable="true" Editable="false" />
                    <PropertyColumn Property="x => x.Description" Title="Description" CellStyle="width: 50%;" Sortable="true" Editable="false" />
                    <TemplateColumn Title="Results" CellStyle="width: 15%;" Sortable="false">
                        <CellTemplate>
                            <MudText>@GetResultSummary(context.Item)</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn CellStyle="width: 5%;">
                        <CellTemplate>
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@((MouseEventArgs _) => DeleteGravitationalFieldCalculationOrder(context.Item.MetaInfo.ID))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="GravitationalFieldCalculationOrder" />
                </PagerContent>
            </MudDataGrid>
        </div>
    }

    @if (isHiddenMainPanel && currentGravitationalFieldCalculationOrder != null)
    {
        <GravitationalFieldCalculationOrderEdit CurrentGravitationalFieldCalculationOrder="@currentGravitationalFieldCalculationOrder" OnUpdate="@ShowMainPanel" />
    }
</MudUnitAndReferenceChoiceTag>

@code {
    private List<GravitationalFieldCalculationOrder> gravitationalFieldCalculationOrderList = new();
    private List<GravitationalFieldCalculationOrder> selectedGravitationalFieldCalculationOrderList = new();
    private GravitationalFieldCalculationOrder? currentGravitationalFieldCalculationOrder;
    public bool isHiddenMainPanel;
    public bool isHiddenEditPanel;
    private string? _searchString;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isHiddenMainPanel = false;
            isHiddenEditPanel = true;
            currentGravitationalFieldCalculationOrder = null;

            logger.LogInformation("Trying to load list of GravitationalFieldCalculationOrder from client: " + Api.HostNameGravitationalField);
            gravitationalFieldCalculationOrderList = (await Api.ClientGravitationalField.GetAllGravitationalFieldCalculationOrderAsync()).ToList();
            if (gravitationalFieldCalculationOrderList != null)
            {
                gravitationalFieldCalculationOrderList.Sort((t1, t2) => string.Compare(t1.Name, t2.Name, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                logger.LogWarning("Returned list of GravitationalFieldCalculationOrder were null on initialization");
                Snackbar.Add("Returned list of Earth Gravitational Field batch calculations were null on initialization", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem GravitationalFieldCalculationOrder initialization");
            Snackbar.Add("Problem while loading Earth Gravitational Field batch calculations", Severity.Warning);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddGravitationalFieldCalculationOrder()
    {
        try
        {
            var creationDate = DateTimeOffset.UtcNow;
            var order = PseudoConstructors.ConstructGravitationalFieldCalculationOrder();
            order.MetaInfo = CreateMetaInfo(Guid.NewGuid(), "GravitationalFieldCalculationOrder/");
            order.Name = "Default Earth Gravitational Field Batch Calculation";
            order.Description = string.Empty;
            order.CreationDate = creationDate;
            order.LastModificationDate = creationDate;
            order.RawGravitationalField = CreateGravitationalField(
                "Default Earth Gravitational Field Input",
                "Input data for " + order.Name,
                GravitationalFieldType.Raw,
                creationDate);
            order.CompletedGravitationalField = null;

            await Api.ClientGravitationalField.PostGravitationalFieldCalculationOrderAsync(order);
            Snackbar.Add("Earth Gravitational Field batch calculation created successfully", Severity.Success);
            await OnInitializedAsync();
            var addedOrder = gravitationalFieldCalculationOrderList.FirstOrDefault(item => item.MetaInfo?.ID == order.MetaInfo.ID);
            if (addedOrder != null)
            {
                await RowClicked(new DataGridRowClickEventArgs<GravitationalFieldCalculationOrder>(new MouseEventArgs(), addedOrder, -1));
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Impossible to add a new GravitationalFieldCalculationOrder");
            Snackbar.Add("Impossible to add a new Earth Gravitational Field batch calculation", Severity.Warning);
        }
    }

    private MetaInfo CreateMetaInfo(Guid id, string endPoint)
    {
        return new MetaInfo
        {
            ID = id,
            HttpHostName = Api.HostNameGravitationalField,
            HttpHostBasePath = Api.HostBasePathGravitationalField,
            HttpEndPoint = endPoint
        };
    }

    private GravitationalField CreateGravitationalField(string? name, string? description, GravitationalFieldType type, DateTimeOffset date)
    {
        var field = PseudoConstructors.ConstructGravitationalField();
        field.MetaInfo = CreateMetaInfo(Guid.NewGuid(), "GravitationalField/");
        field.Name = name;
        field.Description = description;
        field.CreationDate = date;
        field.LastModificationDate = date;
        field.Type = type;
        field.GravitationalDataTable = new List<GravitationalData>
        {
            PseudoConstructors.ConstructGravitationalData()
        };
        return field;
    }

    private async Task RowClicked(DataGridRowClickEventArgs<GravitationalFieldCalculationOrder> args)
    {
        if (args.Item?.MetaInfo == null)
        {
            return;
        }

        await EditGravitationalFieldCalculationOrder(args.Item.MetaInfo.ID);
    }

    private async Task EditGravitationalFieldCalculationOrder(Guid id)
    {
        try
        {
            currentGravitationalFieldCalculationOrder = await Api.ClientGravitationalField.GetGravitationalFieldCalculationOrderByIdAsync(id);
            if (currentGravitationalFieldCalculationOrder != null)
            {
                isHiddenMainPanel = true;
                isHiddenEditPanel = false;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                logger.LogWarning("Impossible to load GravitationalFieldCalculationOrder");
                Snackbar.Add("Impossible to load Earth Gravitational Field batch calculation", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Impossible to load GravitationalFieldCalculationOrder to be edited");
            Snackbar.Add("Impossible to load Earth Gravitational Field batch calculation", Severity.Warning);
        }
    }

    private async Task<bool> ConfirmDeletion()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<DialogDeleteTemplate>("DELETE", options);
        var result = await dialog.Result;
        StateHasChanged();
        return result != null && !result.Canceled;
    }

    private async Task DeleteGravitationalFieldCalculationOrder(Guid id)
    {
        try
        {
            if (await ConfirmDeletion())
            {
                await Api.ClientGravitationalField.DeleteGravitationalFieldCalculationOrderByIdAsync(id);
                await OnInitializedAsync();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Impossible to delete GravitationalFieldCalculationOrder");
            Snackbar.Add("Impossible to delete Earth Gravitational Field batch calculation", Severity.Warning);
        }
    }

    private async Task DeleteSelectedGravitationalFieldCalculationOrder()
    {
        try
        {
            if (selectedGravitationalFieldCalculationOrderList.Count == 0)
            {
                Snackbar.Add("No Earth Gravitational Field batch calculation selected", Severity.Info);
                return;
            }

            if (await ConfirmDeletion())
            {
                foreach (GravitationalFieldCalculationOrder order in selectedGravitationalFieldCalculationOrderList)
                {
                    if (order.MetaInfo != null)
                    {
                        await Api.ClientGravitationalField.DeleteGravitationalFieldCalculationOrderByIdAsync(order.MetaInfo.ID);
                    }
                }
                await OnInitializedAsync();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Impossible to delete selected GravitationalFieldCalculationOrder");
            Snackbar.Add("Impossible to delete selected Earth Gravitational Field batch calculations", Severity.Warning);
        }
    }

    private Func<GravitationalFieldCalculationOrder, bool> _gravitationalFieldCalculationOrderFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        if ($"{x.Name} {x.Description} {GetResultSummary(x)}".Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };

    private string GetResultSummary(GravitationalFieldCalculationOrder order)
    {
        var resultCount = order.CompletedGravitationalField?.GravitationalDataTable?.Count ?? 0;
        return resultCount == 0 ? "Not calculated" : $"{resultCount} point(s)";
    }

    private void SelectedItemsChanged(HashSet<GravitationalFieldCalculationOrder> items)
    {
        selectedGravitationalFieldCalculationOrderList.Clear();
        selectedGravitationalFieldCalculationOrderList.InsertRange(0, items);
    }

    private async void ShowMainPanel()
    {
        isHiddenMainPanel = false;
        isHiddenEditPanel = true;
        await OnInitializedAsync();
    }
}
