@using System.Reflection.Metadata
@inject ILogger<MudInputWithUnitAdornment> logger
@inject IGravitationalFieldAPIUtils Api
@inject ISnackbar Snackbar


<MudPaper Class="ma-2 pa-2" Elevation="4" Style="@($"background:{DataUtils.FLOATING_COLOUR};")">
    <MudPaper Class="ma-1 pa-1" Elevation="2">
        <MudToolBar Dense="true">
            <MudText Typo="Typo.h6" Class="mr-4">Calculation Order</MudText>
            <MudButton StartIcon="@Icons.Material.Filled.SaveAs" Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveAsGravitationalFieldCalculationOrder" Class="ml-1">Save new</MudButton>
            @if (GravitationalFieldCalculationOrderId != null)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Save" Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveGravitationalFieldCalculationOrder" Class="ml-1">Save</MudButton>
            }
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Close" Variant="Variant.Outlined" Color="Color.Error" OnClick="SendMessage" Class="ml-1">Close</MudButton>
        </MudToolBar>
        <MudDivider Class="my-1"/>
        <MudPaper Class="pa-4 ma-2" Elevation="0">
            <MudGrid>
                <MudItem xs="6">
                    <MudTextField @bind-Value="currentGravitationalFieldCalculationOrder.Name" Label="Name" Variant="Variant.Outlined" Required="true" For="@(() => currentGravitationalFieldCalculationOrder.Name)" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="currentGravitationalFieldCalculationOrder.Description" Label="Description" Variant="Variant.Outlined" For="@(() => currentGravitationalFieldCalculationOrder.Description)" />
                </MudItem>
            </MudGrid>
            <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Class="mx-2 my-1">
                    <MudTabPanel Text="Table">
                        <MudTable T=GravitationalData Items="currentGravitationalFieldCalculationOrder.RawGravitationalField.GravitationalDataTable">
                            <HeaderContent>
                                <MudTh>Lattitude [@(Parent!.GetUnitLabel("PlaneAngleGeodesic"))]</MudTh>
                                <MudTh>Longitude [@(Parent!.GetUnitLabel("PlaneAngleGeodesic"))]</MudTh>
                                <MudTh>Depth [@(Parent!.GetUnitLabel("DepthDrilling"))]</MudTh>
                                <MudTh>
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Color="Color.Info" OnClick="AddDataSet">Add</MudButton>
                                </MudTh>
                                <MudTh>
                                    <MudButton StartIcon="@Icons.Material.Filled.Remove" Variant="Variant.Text" Color="Color.Info" OnClick="RemoveDataSet">Remove</MudButton>
                                </MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudInputAngleWithUnit
                                        SIValue="context.Lattitude"
                                        SIValueChanged="@(val => context.Lattitude = val)"/>
                                </MudTd>
                                <MudTd>
                                    <MudInputAngleWithUnit
                                        SIValue="context.Longitude"
                                        SIValueChanged="@(val => context.Longitude = val)"/>
                                </MudTd>
                                <MudTd>
                                    <MudInputWithUnit
                                        SIValue="context.Depth"
                                        QuantityName="DepthDrilling"
                                        SIValueChanged="@(val => context.Depth = val)"/>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudTabPanel>
                    <MudTabPanel Text="Range">
                        <MudPaper Class="pa-3 ma-2">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">Latitude [@(Parent!.GetUnitLabel("PlaneAngleGeodesic"))]</MudText>
                            <MudGrid>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.body2" Class="mb-1">Min</MudText>                                    
                                    <MudInputWithUnitAdornment SIValue="_latMin" QuantityName="PlaneAngleGeodesic" SIValueChanged="@(val => _latMin = val)"/>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.body2" Class="mb-1">Max</MudText>                                    
                                    <MudInputWithUnitAdornment SIValue="_latMax" QuantityName="PlaneAngleGeodesic" SIValueChanged="@(val => _latMax = val)"/>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.body2" Class="mb-1">Step</MudText>                                                                        
                                    <MudInputWithUnitAdornment SIValue="_latStep" QuantityName="PlaneAngleGeodesic" SIValueChanged="@(val => _latStep = val)"/>
                                </MudItem>
                            </MudGrid>
                            <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2">Longitude [@(Parent!.GetUnitLabel("PlaneAngleGeodesic"))]</MudText>
                            <MudGrid>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.body2" Class="mb-1">Min</MudText>
                                    <MudInputWithUnitAdornment SIValue="_lonMin" QuantityName="PlaneAngleGeodesic" SIValueChanged="@(val => _lonMin = val)"/>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.body2" Class="mb-1">Max</MudText>
                                    <MudInputWithUnitAdornment SIValue="_lonMax" QuantityName="PlaneAngleGeodesic" SIValueChanged="@(val => _lonMax = val)"/>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.body2" Class="mb-1">Step</MudText>
                                    <MudInputWithUnitAdornment SIValue="_lonStep" QuantityName="PlaneAngleGeodesic" SIValueChanged="@(val => _lonStep = val)"/>
                                </MudItem>
                            </MudGrid>
                            <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2">Depth [@(Parent!.GetUnitLabel("DepthDrilling"))]</MudText>
                            <MudGrid>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.body2" Class="mb-1">Depth</MudText>
                                    <MudInputWithUnitAdornment SIValue="_rangeDepth" QuantityName="DepthDrilling" SIValueChanged="@(val => _rangeDepth = val)"/>
                                </MudItem>
                            </MudGrid>
                            <MudButton Class="mt-3" StartIcon="@Icons.Material.Filled.Calculate" Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateFromRange">Generate Table</MudButton>
                        </MudPaper>
                    </MudTabPanel>
                </MudTabs>

        </MudPaper>
    </MudPaper>
</MudPaper>

@code{
     [CascadingParameter]
    private MudUnitAndReferenceChoiceTag? Parent { get; set; }
    [Parameter]
    public Guid? GravitationalFieldCalculationOrderId { get; set; }
    [Parameter]
    public EventCallback ValueChanged {get; set;}    

    private List<GravitationalField> unprocessedGravitationalFieldList = new();
    private GravitationalFieldCalculationOrder currentGravitationalFieldCalculationOrder = PseudoConstructors.ConstructGravitationalFieldCalculationOrder();
    private double _latMin = 0;
    private double _latMax = 0;
    private double _latStep = Math.PI / 180.0; // 1 degree
    private double _lonMin = 0;
    private double _lonMax = 0;
    private double _lonStep = Math.PI / 180.0;
    private double _rangeDepth = 0;
    protected override async Task OnInitializedAsync()
    {
        if (GravitationalFieldCalculationOrderId != null)
        {
            currentGravitationalFieldCalculationOrder = await Api.ClientGravitationalField.GetGravitationalFieldCalculationOrderByIdAsync(GravitationalFieldCalculationOrderId.Value);
        }
        unprocessedGravitationalFieldList = await Api.ClientGravitationalField.GetAllCompletedGravitationalFieldAsync(false);
    
        await InvokeAsync(() => { StateHasChanged(); });
    }
    private void AddDataSet()
    {
        currentGravitationalFieldCalculationOrder.
            RawGravitationalField.
                GravitationalDataTable.Add(PseudoConstructors.ConstructGravitationalData());
    }
    private void RemoveDataSet()
    {
        if (currentGravitationalFieldCalculationOrder.RawGravitationalField.GravitationalDataTable.Count > 1)
        {
            currentGravitationalFieldCalculationOrder.RawGravitationalField.
                                                        GravitationalDataTable.RemoveAt(currentGravitationalFieldCalculationOrder.
                                                                                            RawGravitationalField.
                                                                                            GravitationalDataTable.Count - 1);    
        }
        else
        {
            Snackbar.Add("At least one data point is required", Severity.Warning);
        }
    }

    //Send message to parent component
    private async Task SendMessage()
    {
        await ValueChanged.InvokeAsync();
    }  
    //Add/Edit panel controls
    private async Task SaveGravitationalFieldCalculationOrder()
    {
        try
        {
            if (GravitationalFieldCalculationOrderId != null)
            {
                currentGravitationalFieldCalculationOrder.LastModificationDate = DateTimeOffset.UtcNow;            
                await Api.ClientGravitationalField.PutGravitationalFieldCalculationOrderByIdAsync((Guid) GravitationalFieldCalculationOrderId, currentGravitationalFieldCalculationOrder);
                Snackbar.Add("GravitationalFieldCalculationOrder updated successfully", Severity.Success);
                await SendMessage();
            }
            else
            {
                Snackbar.Add("GravitationalFieldCalculationOrder not found for edition", Severity.Success);
            }

        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving GravitationalFieldCalculationOrder");
            Snackbar.Add("Error saving GravitationalFieldCalculationOrder: " + ex.Message, Severity.Warning);
        }
    }
    private async Task SaveAsGravitationalFieldCalculationOrder()
    {
        try
        {
            currentGravitationalFieldCalculationOrder.MetaInfo.ID = Guid.NewGuid();
            currentGravitationalFieldCalculationOrder.CreationDate = DateTimeOffset.UtcNow;
            currentGravitationalFieldCalculationOrder.LastModificationDate = DateTimeOffset.UtcNow;
            await Api.ClientGravitationalField.PostGravitationalFieldCalculationOrderAsync(currentGravitationalFieldCalculationOrder);
            Snackbar.Add("GravitationalFieldCalculationOrder updated successfully", Severity.Success);
            await SendMessage();                        
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving GravitationalFieldCalculationOrder");
            Snackbar.Add("Error saving GravitationalFieldCalculationOrder: " + ex.Message, Severity.Warning);
        }
    }      
    private void GenerateFromRange()
    {
        if (_latStep <= 0 || _lonStep <= 0)
        {
            Snackbar.Add("Step values must be greater than zero", Severity.Warning);
            return;
        }
        var points = new List<GravitationalData>();
        for (double lat = _latMin; lat <= _latMax + _latStep * 1e-9; lat += _latStep)
        {
            for (double lon = _lonMin; lon <= _lonMax + _lonStep * 1e-9; lon += _lonStep)
            {
                points.Add(new GravitationalData { Lattitude = lat, Longitude = lon, Depth = _rangeDepth });
            }
        }
        if (points.Count == 0)
        {
            Snackbar.Add("Range produced no points — check min/max/step values", Severity.Warning);
            return;
        }
        currentGravitationalFieldCalculationOrder.RawGravitationalField.GravitationalDataTable = points;
    }
    //Update unit system
    private void ManageUnits(){}        
    
}
