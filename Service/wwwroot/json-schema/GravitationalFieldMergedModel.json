  "components": {
    "schemas": {
      "CountPerDay": {
        "type": "object",
        "properties": {
          "Date": {
            "type": "string",
            "format": "date-time"
          },
          "Count": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GravitationalData": {
        "type": "object",
        "properties": {
          "Latitude": {
            "type": "number",
            "format": "double",
            "description": "WGS84 geodetic latitude in SI radians.",
            "minimum": -1.5707963267948966,
            "maximum": 1.5707963267948966
          },
          "Longitude": {
            "type": "number",
            "format": "double",
            "description": "WGS84 geodetic longitude in SI radians.",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          },
          "Depth": {
            "type": "number",
            "format": "double",
            "description": "True vertical depth below the WGS84 ellipsoid in metres, positive downward."
          },
          "GravityIntensityX": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Calculated easterly gravity acceleration in metres per second squared."
          },
          "GravityIntensityY": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Calculated northerly gravity acceleration in metres per second squared."
          },
          "GravityIntensityZ": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Calculated upward gravity acceleration in metres per second squared, normally negative."
          }
        }
      },
      "GravitationalField": {
        "type": "object",
        "properties": {
          "MetaInfo": {
            "$ref": "#/components/schemas/MetaInfo"
          },
          "Name": {
            "type": "string",
            "nullable": true
          },
          "Description": {
            "type": "string",
            "nullable": true
          },
          "CreationDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "LastModificationDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Type": {
            "$ref": "#/components/schemas/GravitationalFieldType"
          },
          "GravitationalDataTable": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GravitationalData"
            },
            "nullable": true
          }
        }
      },
