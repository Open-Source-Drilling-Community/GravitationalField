@page "/CompletedGravitationalField"
@inject ILogger<GravitationalFieldMain> logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
<MudUnitAndReferenceChoiceTag HttpHost=@APIUtils.HostNameUnitConversion
                              HttpBasePath=@APIUtils.HostBasePathUnitConversion
                              HttpController="UnitSystem/"
                              UnitSystemName="@DataUtils.UnitAndReferenceParameters.UnitSystemName"
                              UnitSystemNameChanged="@DataUtils.UpdateUnitSystemName">
    @if (gravitationalFieldList == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div hidden="@isHiddenMainPanel">
            <MudDataGrid T="GravitationalField" MultiSelection="true" Items="@gravitationalFieldList" SelectedItemsChanged="@SelectedItemsChanged"
                         EditMode="DataGridEditMode.Cell"
                         Hover="true" 
                         SortMode="SortMode.Multiple" QuickFilter="@_gravitationalFieldFilter" Filterable="false"
                         ReadOnly="false" ColumnResizeMode="ResizeMode.Column" Elevation="0">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Gravitational Field</MudText>
                    <MudButton OnClick="@AddGravitationalField" Color="@Color.Success" Class="add-item-btn">Add</MudButton>
                    <MudButton OnClick="@DeleteSelectedGravitationalField" Color="@Color.Error" Class="add-item-btn">Delete</MudButton>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <Columns>
                    <SelectColumn T="GravitationalField" />
                    <PropertyColumn Property="x => x.Name" Title="Name" CellStyle="width: 30%;" Sortable="true" Editable="false" />
                    <PropertyColumn Property="x => x.Description" Title="Description" CellStyle="width: 40%;" Sortable="true" Editable="false" />
                    <TemplateColumn CellStyle="width: 25%;">
                        <EditTemplate>
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.RemoveRedEye" OnClick="(() => EditGravitationalField(context.Item.MetaInfo.ID))" />                                                
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="(() => DeleteGravitationalField(context.Item.MetaInfo.ID))" />
                        </EditTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="GravitationalField" />
                </PagerContent>
            </MudDataGrid>
        </div>
    }
    @if (isHiddenMainPanel && (!isHiddenEditPanel))
    {
        <GravitationalFieldEdit GravitationalFieldId="@gravitationalFieldIdBeingEdited"  ValueChanged="HandleEditPanelClosed" />
    }
</MudUnitAndReferenceChoiceTag>

@code {
    // GravitationalField related variables
    private List<GravitationalField> gravitationalFieldList = new();
    private List<GravitationalField> selectedGravitationalFieldList = new();
    private GravitationalField? currentGravitationalField;
    private List<object?>? inputDataList = new(); // container used to pass input data to the GravitationalFieldEdit razor component without specifying content types (required by µservice Template)
                                                  // GravitationalField related variables
    // UI related variables
    public bool isHiddenMainPanel;
    public bool isHiddenEditPanel;
    private Guid? gravitationalFieldIdBeingEdited;
    private string? _searchString;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Show main panel
            isHiddenMainPanel = false;
            isHiddenEditPanel = true;
            currentGravitationalField = null;

            // Starting all loading tasks asynchronously
            logger.LogInformation("Trying to load list of GravitationalField from client: " + APIUtils.HttpClientGravitationalField);
            var gravitationalFieldTask = APIUtils.ClientGravitationalField.GetAllCompletedGravitationalFieldAsync(true);

            List<Task> loadingTaskList = new List<Task> { gravitationalFieldTask };
            loadingTaskList.Add(gravitationalFieldTask);

            // Awaiting tasks and retrieve results as they become available
            while (loadingTaskList.Count > 0)
            {
                Task finishedTask = await Task.WhenAny(loadingTaskList);
                if (finishedTask == gravitationalFieldTask)
                {
                    try
                    {
                        gravitationalFieldList = (List<GravitationalField>)await gravitationalFieldTask; // awaiting the finished task allows to retrieve its result and throw exception if needed
                        if (gravitationalFieldList != null)
                        {
                            gravitationalFieldList.Sort((t1, t2) => t1.Name.CompareTo(t2.Name));
                        }
                        else
                        {
                            logger.LogWarning("Returned list of GravitationalField were null on initialization");
                            Snackbar.Add("Returned list of GravitationalField were null on initialization", Severity.Warning);
                        }
                    }
                    catch (ApiException ex)
                    {
                        logger.LogError(ex, "Impossible to load GravitationalField from client");
                    }
                }             
                loadingTaskList.Remove(finishedTask);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem GravitationalField initialization");
        }
        await InvokeAsync(() => { StateHasChanged(); });
    }

    private async Task AddGravitationalField()
    {
        isHiddenMainPanel = true;
        isHiddenEditPanel = false;
        gravitationalFieldIdBeingEdited = null;
    }

    private async Task EditGravitationalField(Guid id)
    {
        isHiddenMainPanel = true;
        isHiddenEditPanel = false;
        gravitationalFieldIdBeingEdited = id;
    }
    private async Task HandleEditPanelClosed()
    {
        isHiddenMainPanel = false;
        isHiddenEditPanel = true;
        gravitationalFieldIdBeingEdited = null;
        await OnInitializedAsync();
    }

    private async Task<bool> ConfirmDeletion()
    {
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true    
        };
        var dialog = await DialogService.ShowAsync<DialogDeleteTemplate>("DELETE", options);
        var result = await dialog.Result;
        StateHasChanged();
        if (result == null)
        {
            return false;
        }
        else
        {
            return (!result.Canceled);
        }
    }
    private async Task DeleteGravitationalField(Guid id)
    {
        try
        {
            if (await ConfirmDeletion())
            {
                await APIUtils.ClientGravitationalField.DeleteGravitationalFieldByIdAsync(id);
                await OnInitializedAsync();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Impossible to delete GravitationalField");
        }
    }
    

    private async Task DeleteSelectedGravitationalField()
    {
        try
        {
            if (await ConfirmDeletion())
            {
                foreach (GravitationalField gravitationalField in selectedGravitationalFieldList)
                {
                    await APIUtils.ClientGravitationalField.DeleteGravitationalFieldByIdAsync(gravitationalField.MetaInfo.ID);
                }
                await OnInitializedAsync();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Impossible to delete all GravitationalField");
        }

    }

    //Quick filter - filter gobally across multiple columns with the same input
    private Func<GravitationalField, bool>
    _gravitationalFieldFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        if ($"{x.Name} {x.Description}".Contains(_searchString))
            return true;

        return false;
    };
    
    //Events
    private void StartedEditingItem(GravitationalField item)
    {
        //Activating Edit event capture with parameter StartedEditingItem="@StartedEditingItem" in MudDataGrid; arguments are specified in OnClick="@context.Actions.StartedEditingItem(...)"
    }

    private void CancelledEditingItem(GravitationalField item)
    {
        //Activating Cancel event capture with parameter CancelledEditingItem = "@CancelledEditingItem" in MudDataGrid; arguments are specified in OnClick="@context.Actions.CancelledEditingItem(...)"
    }

    private void CommittedItemChanges(GravitationalField item)
    {
        //Activating Commit event capture with parameter CommittedItemChanges = "@CommittedItemChanges" in MudDataGrid; arguments are specified in OnClick="@context.Actions.CommittedEditingItem(...)"
    }

    void SelectedItemsChanged(HashSet<GravitationalField>
        items)
    {
        selectedGravitationalFieldList.Clear();
        selectedGravitationalFieldList.InsertRange(0, items);
    }
}
